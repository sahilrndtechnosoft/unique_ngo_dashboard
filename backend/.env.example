DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/unique_ngo_dash
PORT=3017
NODE_ENV=production

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=5

APP_URL=https://app.uniquemarketing.in
UPLOAD_DIR=uploads
# Comma-separated list of allowed frontend origins. Leave unset to allow all (dev only).
CORS_ORIGIN=https://app.uniquemarketing.in


EXPOSE_OTP_IN_RESPONSE=false

# Firebase Cloud Messaging (push notifications). Leave unset to disable push sends.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SMTP (admin email notifications). Leave unset to disable email sends.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Unique NGO <no-reply@uniquemarketing.in>
